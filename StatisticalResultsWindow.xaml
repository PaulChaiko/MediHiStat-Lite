<Window x:Class="MediHiStat.StatisticalResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Результаты статистического анализа"
        Height="560"
        Width="1250"
        MinHeight="420"
        MinWidth="900"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="IndicatorText"
                       FontSize="18"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="MethodText"
                       Margin="0,4,0,0"
                       Foreground="#FF444444"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <DataGrid x:Name="ResultsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionUnit="CellOrRowHeader"
                  ClipboardCopyMode="IncludeHeader"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Срок" Binding="{Binding TimePoint}" Width="105"/>
                <DataGridTextColumn Header="Группа 1" Binding="{Binding Group1Summary}" Width="230"/>
                <DataGridTextColumn Header="Группа 2" Binding="{Binding Group2Summary}" Width="230"/>
                <DataGridTextColumn Header="Статистика" Binding="{Binding Statistic}" Width="105"/>
                <DataGridTextColumn Header="df" Binding="{Binding DegreesOfFreedom}" Width="55"/>
                <DataGridTextColumn Header="p" Binding="{Binding PValue}" Width="85"/>
                <DataGridTextColumn Header="p (Холм)" Binding="{Binding AdjustedPValue}" Width="95"/>
                <DataGridTextColumn Header="Размер эффекта" Binding="{Binding EffectSize}" Width="120"/>
                <DataGridTextColumn Header="Метод и примечания" Binding="{Binding Notes}" Width="*" MinWidth="220">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="3"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Foreground="#FF555555"
                       Text="Таблица копируется с заголовками и вставляется в Word или Excel."/>
            <Button DockPanel.Dock="Right"
                    Width="100"
                    Margin="8,0,0,0"
                    Padding="8,4"
                    Click="Close_Click"
                    Content="Закрыть"/>
            <Button DockPanel.Dock="Right"
                    Width="120"
                    Margin="8,0,0,0"
                    Padding="8,4"
                    Click="ExportCsv_Click"
                    Content="Экспорт CSV"/>
            <Button DockPanel.Dock="Right"
                    Width="150"
                    Margin="8,0,0,0"
                    Padding="8,4"
                    Click="CopyTable_Click"
                    Content="Копировать таблицу"/>
        </DockPanel>
    </Grid>
</Window>
