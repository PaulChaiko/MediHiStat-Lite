<Window x:Class="MediHiStat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MediHiStat"
        mc:Ignorable="d"
        Title="MediHiStat" Height="510" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.Column="0" Margin="3,3,3,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0"  >
                <DataGrid SelectionUnit="Cell" Name="TableOnePerson" Margin="3,3,3,3" AutoGenerateColumns="False" HorizontalScrollBarVisibility="Disabled" IsReadOnly="False" ItemsSource="{Binding personDataGrids}">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Характеристика" Binding="{Binding Header}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Информация" Binding="{Binding Info}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>


                </DataGrid>
            </Grid>

            <Grid Grid.Column="2" Margin="3,3,3,3" Background="#FFE3DDDD">
                <ScrollViewer>
                    <StackPanel>
                        <TextBox  IsReadOnly="True" x:Name="PatientCount" Margin="3,3,3,3">Всего пациентов:</TextBox>
                        <TextBox IsReadOnly="True" Margin="3,3,3,3">Поиск пациента</TextBox>
                        <ComboBox Margin="3,3,3,3" x:Name="TableOnePersonPatientSearch" SelectionChanged="TableOnePersonPatientSearch_SelectionChanged" Height="20" MaxHeight="900" ></ComboBox>
                        <!--<TextBox IsReadOnly="True" Margin="3,3,3,3">Добавить анализ</TextBox>
                        <ComboBox Margin="3,3,3,3" x:Name="TableOnePersonAddTest"></ComboBox>
                        <TextBox IsReadOnly="True" Margin="3,3,3,3">Убрать анализ</TextBox>
                        <ComboBox Margin="3,3,3,3" x:Name="TableOnePersonDeleteTest"></ComboBox>
                        <TextBox IsReadOnly="True" Margin="3,3,3,3">Добавить сутки</TextBox>
                        <ComboBox Margin="3,3,3,3" x:Name="TableOnePersonAddDay"></ComboBox>
                        <TextBox IsReadOnly="True" Margin="3,3,3,3">Убрать сутки</TextBox>
                        <ComboBox Margin="3,3,3,3" x:Name="TableOnePersonDeleteDay"></ComboBox>-->
                        <Button Height="25" Margin="3,3,3,3" x:Name="AddPerson" Click="AddPerson_Click">Добавить</Button>
                        <Button Height="25" Margin="3,3,3,3" x:Name="RemovePerson" Click="RemovePerson_Click">Удалить</Button>



                    </StackPanel>
                </ScrollViewer>
            </Grid>




        </Grid>

        <Grid Grid.Column="0" Grid.Row="1" Margin="3,3,3,3">
            <ScrollViewer HorizontalScrollBarVisibility="Auto">
                <DataGrid x:Name="MainTestsOfOne" Margin="3,3,3,3" AutoGenerateColumns="False"  IsReadOnly="True" ItemsSource="{Binding Tests}">

