<Window x:Class="MediHiStat.AddingPerson"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить пациента вручную" Height="760" Width="1250" MinHeight="550" MinWidth="850"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,3,0,8"/>
            <Setter Property="MinHeight" Value="25"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="MeasurementCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Margin="0,0,0,10" Text="Заполните карточку и показатели. Результаты можно вставить из Excel: выберите начальную ячейку и нажмите Ctrl+V. Пустая ячейка означает отсутствие результата."/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Пациент"/>
                    <TextBox x:Name="_PersonID"/>
                    <TextBlock Text="Группа"/>
                    <TextBox x:Name="_PatientGroup"/>
                    <TextBlock Text="Возраст (полных лет)"/>
                    <TextBox x:Name="_Age"/>
                    <TextBlock Text="Пол"/>
                    <TextBox x:Name="_Sex"/>
                    <TextBlock Text="Рост"/>
                    <TextBox x:Name="_Height"/>
                    <TextBlock Text="Вес"/>
                    <TextBox x:Name="_Weight"/>
                    <TextBlock Text="Жалобы"/>
                    <TextBox x:Name="_Complaints" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="50"/>
                    <TextBlock Text="Длительность желтухи"/>
                    <TextBox x:Name="_Duration"/>
                    <TextBlock Text="Основной диагноз"/>
                    <TextBox x:Name="_Diagnosis" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="50"/>
                    <TextBlock Text="Сопутствующий диагноз"/>
                    <TextBox x:Name="_AddDiagnosis" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="50"/>
                    <TextBlock Text="Операция"/>
                    <TextBox x:Name="_Operation" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="50"/>
                    <Button x:Name="ButtonAdd" Margin="0,8,0,8" Padding="10,8" Click="ButtonAdd_Click" Content="Сохранить пациента"/>
                </StackPanel>
            </ScrollViewer>
            <DataGrid x:Name="TestsOfOne" Grid.Column="2" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                      FrozenColumnCount="1" SelectionUnit="Cell" SelectionMode="Extended"
                      PreviewKeyDown="DataGrid_PreviewKeyDown" ClipboardCopyMode="ExcludeHeader"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn IsReadOnly="True" Header="Показатель" Binding="{Binding TestName}" Width="210" ElementStyle="{StaticResource MeasurementCell}"/>
                    <DataGridTextColumn Header="Поступление" Binding="{Binding Day0, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="110" ElementStyle="{StaticResource MeasurementCell}"/>
                    <DataGridTextColumn Header="1 сутки" Binding="{Binding Day1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90" ElementStyle="{StaticResource MeasurementCell}"/>
                    <DataGridTextColumn Header="2 сутки" Binding="{Binding Day2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90" ElementStyle="{StaticResource MeasurementCell}"/>
                    <DataGridTextColumn Header="3 сутки" Binding="{Binding Day3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90" ElementStyle="{StaticResource MeasurementCell}"/>
                    <DataGridTextColumn Header="4 сутки" Binding="{Binding Day4, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90" ElementStyle="{StaticResource MeasurementCell}"/>
                    <DataGridTextColumn Header="5 сутки" Binding="{Binding Day5, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90" ElementStyle="{StaticResource MeasurementCell}"/>
                    <DataGridTextColumn Header="6 сутки" Binding="{Binding Day6, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90" ElementStyle="{StaticResource MeasurementCell}"/>
                    <DataGridTextColumn Header="7 сутки" Binding="{Binding Day7, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90" ElementStyle="{StaticResource MeasurementCell}"/>
                    <DataGridTextColumn Header="8 сутки" Binding="{Binding Day8, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90" ElementStyle="{StaticResource MeasurementCell}"/>
                    <DataGridTextColumn Header="9-12 сутки" Binding="{Binding Day9_12, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" ElementStyle="{StaticResource MeasurementCell}"/>
                    <DataGridTextColumn Header="12-16 сутки" Binding="{Binding Day12_16, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" ElementStyle="{StaticResource MeasurementCell}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
